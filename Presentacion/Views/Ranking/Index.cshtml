@model IEnumerable<(string Titulo, int Cantidad)>

@{
    ViewData["Title"] = "Ranking de historias";
}

<h2>Ranking de historias más leídas</h2>

@if (!Model.Any())
{
    <p>Todavía no hay historias con lecturas completadas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Posición</th>
            <th>Historia</th>
            <th>Lecturas completadas</th>
        </tr>
        </thead>
        <tbody>
        @{
            int posicion = 1;
        }

        @foreach (var historia in Model)
        {
            <tr>
                <td>@posicion</td>
                <td>@historia.Titulo</td>
                <td>@historia.Cantidad</td>
            </tr>

            posicion++;
        }
        </tbody>
    </table>
}