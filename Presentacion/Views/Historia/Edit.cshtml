@model DTOs.DTOs.HistoriaDTO

@{
    ViewData["Title"] = "Editar historia";
}

<h1>Editar historia</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Sinopsis" class="form-label"></label>
        <textarea asp-for="Sinopsis" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Categorías</label>

        @foreach (var categoria in ViewBag.Categorias)
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       name="categoriasSeleccionadas"
                       value="@categoria.Id"
                       checked="@(Model.Categorias != null && Model.Categorias.Any(c => c.Id == categoria.Id))" />

                <label class="form-check-label">
                    @categoria.Nombre
                </label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label"></label>

        <select asp-for="Estado" class="form-select">
            <option value="Borrador">Borrador</option>
            <option value="Publicada">Publicada</option>
        </select>
    </div>

    
    <h3>Capítulo inicial</h3>

    <div class="mb-3">
        <label asp-for="CapituloInicial.Titulo" class="form-label">
            Título del capítulo
        </label>

        <input asp-for="CapituloInicial.Titulo" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="CapituloInicial.Texto" class="form-label">
            Texto del capítulo
        </label>

        <textarea asp-for="CapituloInicial.Texto"
              class="form-control"
              rows="4"></textarea>
    </div>

    
    <button type="submit" class="btn btn-primary">
        Guardar cambios
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>